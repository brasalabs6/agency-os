# Data driver: mock | postgres
DATA_DRIVER=mock
DATABASE_URL=postgres://agencyos:agencyos@localhost:5432/agencyos

# App authentication. Development bypass must be false in production.
APP_AUTH_DISABLED=true
SESSION_TTL_DAYS=30
# Demo credentials are only used by DATA_DRIVER=mock + auth enabled.
DEV_ADMIN_PASSWORD=admin-agencyos-2026
DEV_MEMBER_PASSWORD=partner-agencyos-2026

# MCP authentication: none | token | user_query_token | oauth
# Keep token for manual clients/rollback. After creating per-user ChatGPT credentials,
# use MCP_AUTH_MODE=user_query_token for ChatGPT "No authentication" connections.
MCP_AUTH_MODE=token
MCP_API_TOKEN=replace-with-a-long-random-token
MCP_OAUTH_ISSUER=https://your-idp.example.com/
MCP_OAUTH_AUDIENCE=https://crm.example.com/mcp
MCP_OAUTH_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
MCP_REQUIRED_SCOPES=leads.read,leads.write

NEXT_PUBLIC_APP_NAME=AgencyOS Leads


# AI commercial automation integrations
# External WhatsApp gateways push read-only conversation snapshots to:
# POST /api/integrations/whatsapp/ingest with Authorization: Bearer <WHATSAPP_INGEST_TOKEN>
WHATSAPP_INGEST_TOKEN=replace-with-a-long-random-token

# Approved WhatsApp sends. Keep mock locally; production should use a controlled gateway webhook.
WHATSAPP_SEND_MODE=mock
WHATSAPP_SEND_WEBHOOK_URL=
WHATSAPP_API_TOKEN=

# Generic approved proposal/contract delivery adapter.
DOCUMENT_SEND_MODE=mock
DOCUMENT_SEND_WEBHOOK_URL=
DOCUMENT_SEND_API_TOKEN=

# Generic signature provider status webhook.
SIGNATURE_WEBHOOK_TOKEN=replace-with-a-long-random-token


# Keep the new commercial domain off in production until migration 0008 is
# applied and verified. The existing lead detail remains available.
AI_COMMERCIAL_AUTOMATION_ENABLED=false
